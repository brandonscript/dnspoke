# Optional override; otherwise the server generates and saves a random hostname.
# RELAY_PUBLIC_URL=https://dns.example.com
DNS_ZONE=example.com
DNS_PROVIDER=your_provider
DNS_PROVIDER_COOLDOWN=0

# Existing Docker network and fixed source IP of your HTTPS proxy.
PROXY_NETWORK=proxy
DNS_TRUST_PROXY=1
DNS_TRUSTED_PROXY=172.20.0.2

# Add the credential variables required by your Lexicon provider:
# https://dns-lexicon.github.io/dns-lexicon/configuration_reference.html
